# Development only. In production, leave this unset when the root Vercel
# configuration proxies /api to the Passport backend on the same domain. The
# installed PWA needs that same origin to restore its secure HTTP-only session.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Public Passport frontend origin used for the standalone Staff PWA. Do not set
# this to app.gohighlevel.com or a HighLevel white-label host.
VITE_PWA_APP_URL=http://localhost:5173
VITE_GHL_APP_ID=
VITE_GHL_PARENT_ORIGINS=https://app.gohighlevel.com
VITE_STRIPE_PUBLISHABLE_KEY=
